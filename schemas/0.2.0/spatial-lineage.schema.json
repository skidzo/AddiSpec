{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/skidzo/AddiSpec/schemas/0.2.0/spatial-lineage.schema.json",
  "title": "AddiSpec spatial lineage record",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "$schema",
    "schemaVersion",
    "id",
    "title",
    "process",
    "sourceRefs",
    "entities",
    "coordinateFrames",
    "derivations",
    "orientationConstraints",
    "measurementRegions",
    "evidenceGaps",
    "externalReferences"
  ],
  "properties": {
    "$schema": {
      "type": "string",
      "minLength": 1
    },
    "schemaVersion": {
      "const": "0.2.0"
    },
    "id": {
      "type": "string",
      "pattern": "^[A-Z0-9][A-Z0-9._-]+$"
    },
    "title": {
      "type": "string",
      "minLength": 1
    },
    "process": {
      "type": "string",
      "minLength": 1
    },
    "sourceRefs": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "entities": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "scope",
          "role"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z0-9][a-z0-9._-]+$"
          },
          "scope": {
            "enum": [
              "individual",
              "cohort",
              "template",
              "unspecified"
            ]
          },
          "role": {
            "enum": [
              "build-artifact",
              "derived-test-specimen",
              "prepared-sample",
              "fracture-artifact",
              "measurement-artifact",
              "nominal-geometry"
            ]
          },
          "coordinateFrameRef": {
            "type": "string",
            "minLength": 1
          },
          "geometry": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "family",
              "definitionStatus"
            ],
            "properties": {
              "family": {
                "type": "string",
                "minLength": 1
              },
              "definitionStatus": {
                "enum": [
                  "complete",
                  "incomplete",
                  "not-applicable",
                  "not-reported"
                ]
              },
              "parameters": {
                "type": "object"
              },
              "missingParameters": {
                "type": "array",
                "uniqueItems": true,
                "items": {
                  "type": "string",
                  "minLength": 1
                }
              },
              "notes": {
                "type": "array",
                "items": {
                  "type": "string",
                  "minLength": 1
                }
              }
            }
          },
          "externalReferenceRefs": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            },
            "uniqueItems": true
          },
          "usage": {
            "enum": [
              "test",
              "retained",
              "not-reported"
            ]
          }
        }
      }
    },
    "coordinateFrames": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "frameType",
          "transformToParent",
          "definition"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z0-9][a-z0-9._-]+$"
          },
          "frameType": {
            "enum": [
              "machine",
              "build-platform",
              "build",
              "scan",
              "artifact",
              "sample",
              "measurement",
              "fracture-surface",
              "instrument",
              "material-history"
            ]
          },
          "parentFrameRef": {
            "type": "string",
            "minLength": 1
          },
          "transformToParent": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "status"
            ],
            "properties": {
              "model": {
                "enum": [
                  "rigid"
                ]
              },
              "status": {
                "enum": [
                  "exact",
                  "reported",
                  "computed",
                  "measured",
                  "estimated",
                  "not-reported",
                  "not-applicable"
                ]
              },
              "translationMm": {
                "type": "array",
                "minItems": 3,
                "maxItems": 3,
                "items": {
                  "type": "number"
                }
              },
              "basis": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "x",
                  "y",
                  "z"
                ],
                "properties": {
                  "x": {
                    "type": "array",
                    "minItems": 3,
                    "maxItems": 3,
                    "items": {
                      "type": "number"
                    }
                  },
                  "y": {
                    "type": "array",
                    "minItems": 3,
                    "maxItems": 3,
                    "items": {
                      "type": "number"
                    }
                  },
                  "z": {
                    "type": "array",
                    "minItems": 3,
                    "maxItems": 3,
                    "items": {
                      "type": "number"
                    }
                  }
                }
              },
              "direction": {
                "const": "child-to-parent"
              },
              "evidence": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "status",
                  "sourceRef",
                  "locator"
                ],
                "properties": {
                  "status": {
                    "enum": [
                      "reported",
                      "measured",
                      "computed",
                      "estimated",
                      "schematic-only",
                      "not-reported"
                    ]
                  },
                  "sourceRef": {
                    "type": "string",
                    "minLength": 1
                  },
                  "locator": {
                    "type": "string",
                    "minLength": 1
                  },
                  "method": {
                    "type": "string",
                    "minLength": 1
                  }
                }
              },
              "appliesTo": {
                "type": "array",
                "items": {
                  "type": "string",
                  "minLength": 1
                },
                "minItems": 1
              },
              "uncertainty": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "description"
                ],
                "properties": {
                  "description": {
                    "type": "string",
                    "minLength": 1
                  },
                  "translationBoundMm": {
                    "type": "number",
                    "minimum": 0
                  },
                  "rotationBoundDeg": {
                    "type": "number",
                    "minimum": 0,
                    "maximum": 180
                  }
                }
              }
            }
          },
          "definition": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "status"
            ],
            "properties": {
              "status": {
                "enum": [
                  "specified",
                  "not-reported"
                ]
              },
              "origin": {
                "type": "string",
                "minLength": 1
              },
              "axes": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "x",
                  "y",
                  "z"
                ],
                "properties": {
                  "x": {
                    "type": "string",
                    "minLength": 1
                  },
                  "y": {
                    "type": "string",
                    "minLength": 1
                  },
                  "z": {
                    "type": "string",
                    "minLength": 1
                  }
                }
              },
              "evidence": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "status",
                  "sourceRef",
                  "locator"
                ],
                "properties": {
                  "status": {
                    "enum": [
                      "reported",
                      "measured",
                      "computed",
                      "estimated",
                      "schematic-only",
                      "not-reported"
                    ]
                  },
                  "sourceRef": {
                    "type": "string",
                    "minLength": 1
                  },
                  "locator": {
                    "type": "string",
                    "minLength": 1
                  },
                  "method": {
                    "type": "string",
                    "minLength": 1
                  }
                }
              }
            }
          }
        }
      }
    },
    "derivations": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "type",
          "parentRef",
          "childRef",
          "evidence"
        ],
        "properties": {
          "type": {
            "enum": [
              "extracted-from",
              "machined-from",
              "sectioned-from",
              "fractured-from",
              "prepared-from"
            ]
          },
          "parentRef": {
            "type": "string",
            "minLength": 1
          },
          "childRef": {
            "type": "string",
            "minLength": 1
          },
          "evidence": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "status",
              "sourceRef",
              "locator"
            ],
            "properties": {
              "status": {
                "enum": [
                  "reported",
                  "measured",
                  "computed",
                  "estimated",
                  "schematic-only",
                  "not-reported"
                ]
              },
              "sourceRef": {
                "type": "string",
                "minLength": 1
              },
              "locator": {
                "type": "string",
                "minLength": 1
              },
              "method": {
                "type": "string",
                "minLength": 1
              }
            }
          }
        }
      }
    },
    "orientationConstraints": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "subjectRef",
          "relationType",
          "first",
          "second",
          "angleDeg",
          "azimuthStatus",
          "evidence"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z0-9][a-z0-9._-]+$"
          },
          "subjectRef": {
            "type": "string",
            "minLength": 1
          },
          "relationType": {
            "enum": [
              "axis-to-axis",
              "axis-to-plane",
              "plane-to-plane"
            ]
          },
          "first": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "frameRef",
              "feature"
            ],
            "properties": {
              "frameRef": {
                "type": "string",
                "minLength": 1
              },
              "feature": {
                "type": "string",
                "minLength": 1
              }
            }
          },
          "second": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "frameRef",
              "feature"
            ],
            "properties": {
              "frameRef": {
                "type": "string",
                "minLength": 1
              },
              "feature": {
                "type": "string",
                "minLength": 1
              }
            }
          },
          "angleDeg": {
            "type": "number",
            "minimum": 0,
            "maximum": 180
          },
          "azimuthStatus": {
            "enum": [
              "reported",
              "not-reported",
              "not-applicable"
            ]
          },
          "evidence": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "status",
              "sourceRef",
              "locator"
            ],
            "properties": {
              "status": {
                "enum": [
                  "reported",
                  "measured",
                  "computed",
                  "estimated",
                  "schematic-only",
                  "not-reported"
                ]
              },
              "sourceRef": {
                "type": "string",
                "minLength": 1
              },
              "locator": {
                "type": "string",
                "minLength": 1
              },
              "method": {
                "type": "string",
                "minLength": 1
              }
            }
          }
        }
      }
    },
    "measurementRegions": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "entityRef",
          "kind",
          "locationStatus",
          "orientationStatus",
          "evidence"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z0-9][a-z0-9._-]+$"
          },
          "entityRef": {
            "type": "string",
            "minLength": 1
          },
          "kind": {
            "enum": [
              "surface",
              "plane",
              "volume",
              "point",
              "grid",
              "fracture-surface"
            ]
          },
          "locationStatus": {
            "enum": [
              "exact",
              "measured",
              "estimated",
              "feature-relative",
              "derived-from-test",
              "not-reported"
            ]
          },
          "orientationStatus": {
            "enum": [
              "exact",
              "reported-constraint",
              "measured",
              "estimated",
              "not-reported"
            ]
          },
          "size": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "values",
              "unit"
            ],
            "properties": {
              "values": {
                "type": "array",
                "minItems": 1,
                "items": {
                  "type": "number",
                  "exclusiveMinimum": 0
                }
              },
              "unit": {
                "type": "string",
                "minLength": 1
              }
            }
          },
          "samplingGrid": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "rows",
              "columns",
              "spacing"
            ],
            "properties": {
              "rows": {
                "type": "integer",
                "minimum": 1
              },
              "columns": {
                "type": "integer",
                "minimum": 1
              },
              "spacing": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "value",
                  "unit"
                ],
                "properties": {
                  "value": {
                    "type": "number",
                    "exclusiveMinimum": 0
                  },
                  "unit": {
                    "type": "string",
                    "minLength": 1
                  }
                }
              }
            }
          },
          "anchor": {
            "type": "string",
            "minLength": 1
          },
          "evidence": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "status",
              "sourceRef",
              "locator"
            ],
            "properties": {
              "status": {
                "enum": [
                  "reported",
                  "measured",
                  "computed",
                  "estimated",
                  "schematic-only",
                  "not-reported"
                ]
              },
              "sourceRef": {
                "type": "string",
                "minLength": 1
              },
              "locator": {
                "type": "string",
                "minLength": 1
              },
              "method": {
                "type": "string",
                "minLength": 1
              }
            }
          },
          "coordinateFrameRef": {
            "type": "string",
            "minLength": 1
          },
          "orientationConstraintRef": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "evidenceGaps": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "notes": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "externalReferences": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "system",
          "namespace",
          "endpoint",
          "kind",
          "relation",
          "identifiers",
          "provenance",
          "resolution"
        ],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "system": {
            "type": "string",
            "minLength": 1
          },
          "namespace": {
            "type": "string",
            "pattern": "^[a-zA-Z][a-zA-Z0-9+.-]*:[^\\s]+$"
          },
          "endpoint": {
            "type": "string",
            "pattern": "^[a-zA-Z][a-zA-Z0-9+.-]*:[^\\s]+$"
          },
          "kind": {
            "enum": [
              "aas",
              "external"
            ]
          },
          "relation": {
            "enum": [
              "machine",
              "build",
              "build-platform",
              "build-artifact",
              "specimen-instance",
              "layer",
              "laser-unit",
              "scan-strategy",
              "process-parameters",
              "material-batch",
              "nominal-geometry",
              "placement",
              "measurement",
              "qualification",
              "storage",
              "heat-treatment",
              "calibration"
            ]
          },
          "identifiers": {
            "type": "object",
            "additionalProperties": false,
            "required": [],
            "properties": {
              "assetId": {
                "type": "string",
                "pattern": "^[a-zA-Z][a-zA-Z0-9+.-]*:[^\\s]+$"
              },
              "submodelId": {
                "type": "string",
                "pattern": "^[a-zA-Z][a-zA-Z0-9+.-]*:[^\\s]+$"
              },
              "entityId": {
                "type": "string",
                "minLength": 1
              },
              "elementPath": {
                "type": "array",
                "items": {
                  "type": "string",
                  "minLength": 1
                }
              }
            }
          },
          "expectedModel": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "templateId",
              "version",
              "revision",
              "semanticId",
              "sourceRevision"
            ],
            "properties": {
              "templateId": {
                "type": "string",
                "pattern": "^[a-zA-Z][a-zA-Z0-9+.-]*:[^\\s]+$"
              },
              "version": {
                "type": "string",
                "minLength": 1
              },
              "revision": {
                "type": "string",
                "minLength": 1
              },
              "semanticId": {
                "type": "string",
                "pattern": "^[a-zA-Z][a-zA-Z0-9+.-]*:[^\\s]+$"
              },
              "sourceRevision": {
                "type": "string",
                "minLength": 1
              }
            }
          },
          "provenance": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "status",
              "sourceRef",
              "locator"
            ],
            "properties": {
              "status": {
                "enum": [
                  "reported",
                  "measured",
                  "computed",
                  "estimated",
                  "schematic-only",
                  "not-reported"
                ]
              },
              "sourceRef": {
                "type": "string",
                "minLength": 1
              },
              "locator": {
                "type": "string",
                "minLength": 1
              },
              "method": {
                "type": "string",
                "minLength": 1
              }
            }
          },
          "resolution": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "status"
            ],
            "properties": {
              "status": {
                "enum": [
                  "not-attempted",
                  "resolved",
                  "unresolved"
                ]
              },
              "checkedAt": {
                "type": "string",
                "minLength": 1
              },
              "reason": {
                "type": "string",
                "minLength": 1
              },
              "target": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "identifiers"
                ],
                "properties": {
                  "identifiers": {
                    "type": "object",
                    "additionalProperties": false,
                    "required": [],
                    "properties": {
                      "assetId": {
                        "type": "string",
                        "pattern": "^[a-zA-Z][a-zA-Z0-9+.-]*:[^\\s]+$"
                      },
                      "submodelId": {
                        "type": "string",
                        "pattern": "^[a-zA-Z][a-zA-Z0-9+.-]*:[^\\s]+$"
                      },
                      "entityId": {
                        "type": "string",
                        "minLength": 1
                      },
                      "elementPath": {
                        "type": "array",
                        "items": {
                          "type": "string",
                          "minLength": 1
                        }
                      }
                    }
                  },
                  "semanticId": {
                    "type": "string",
                    "pattern": "^[a-zA-Z][a-zA-Z0-9+.-]*:[^\\s]+$"
                  },
                  "version": {
                    "type": "string",
                    "minLength": 1
                  },
                  "revision": {
                    "type": "string",
                    "minLength": 1
                  }
                }
              }
            }
          },
          "snapshot": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "path",
              "sha256",
              "bytes",
              "capturedAt",
              "revision",
              "evidence"
            ],
            "properties": {
              "path": {
                "type": "string",
                "minLength": 1
              },
              "sha256": {
                "type": "string",
                "pattern": "^[a-f0-9]{64}$"
              },
              "bytes": {
                "type": "integer",
                "minimum": 1
              },
              "capturedAt": {
                "type": "string",
                "minLength": 1
              },
              "revision": {
                "type": "string",
                "minLength": 1
              },
              "evidence": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "status",
                  "sourceRef",
                  "locator"
                ],
                "properties": {
                  "status": {
                    "enum": [
                      "reported",
                      "measured",
                      "computed",
                      "estimated",
                      "schematic-only",
                      "not-reported"
                    ]
                  },
                  "sourceRef": {
                    "type": "string",
                    "minLength": 1
                  },
                  "locator": {
                    "type": "string",
                    "minLength": 1
                  },
                  "method": {
                    "type": "string",
                    "minLength": 1
                  }
                }
              }
            }
          }
        }
      }
    },
    "placementObservations": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "entityRef",
          "kind",
          "value",
          "vocabulary",
          "evidence"
        ],
        "properties": {
          "entityRef": {
            "type": "string",
            "minLength": 1
          },
          "referenceRef": {
            "type": "string",
            "minLength": 1
          },
          "kind": {
            "enum": [
              "build-zone",
              "build-orientation",
              "test-orientation",
              "section-plane"
            ]
          },
          "value": {
            "type": "string",
            "minLength": 1
          },
          "vocabulary": {
            "type": "string",
            "pattern": "^[a-zA-Z][a-zA-Z0-9+.-]*:[^\\s]+$"
          },
          "evidence": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "status",
              "sourceRef",
              "locator"
            ],
            "properties": {
              "status": {
                "enum": [
                  "reported",
                  "measured",
                  "computed",
                  "estimated",
                  "schematic-only",
                  "not-reported"
                ]
              },
              "sourceRef": {
                "type": "string",
                "minLength": 1
              },
              "locator": {
                "type": "string",
                "minLength": 1
              },
              "method": {
                "type": "string",
                "minLength": 1
              }
            }
          }
        }
      }
    }
  }
}
