{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/skidzo/AddiSpec/schemas/0.2.0/sources.schema.json",
  "title": "AddiSpec source register",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "$schema",
    "schemaVersion",
    "sources"
  ],
  "properties": {
    "$schema": {
      "type": "string",
      "minLength": 1
    },
    "schemaVersion": {
      "const": "0.2.0"
    },
    "sources": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "title",
          "publisher",
          "url",
          "role",
          "redistribution"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z0-9][a-z0-9._-]+$"
          },
          "title": {
            "type": "string",
            "minLength": 1
          },
          "publisher": {
            "type": "string",
            "minLength": 1
          },
          "url": {
            "type": "string",
            "minLength": 1
          },
          "role": {
            "type": "string",
            "minLength": 1
          },
          "license": {
            "type": "string",
            "minLength": 1
          },
          "publicationStatus": {
            "type": "string",
            "minLength": 1
          },
          "reviewStatus": {
            "type": "string",
            "minLength": 1
          },
          "sourceArtifact": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "bytes",
              "sha256"
            ],
            "properties": {
              "bytes": {
                "type": "integer",
                "minimum": 1
              },
              "sha256": {
                "type": "string",
                "pattern": "^[a-f0-9]{64}$"
              }
            }
          },
          "redistribution": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    }
  }
}
