{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/skidzo/AddiSpec/schemas/spatial-lineage.schema.json",
  "title": "AddiSpec spatial lineage record",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "$schema",
    "schemaVersion",
    "id",
    "title",
    "process",
    "sourceRefs",
    "entities",
    "coordinateFrames",
    "derivations",
    "orientationConstraints",
    "measurementRegions",
    "evidenceGaps"
  ],
  "properties": {
    "$schema": { "type": "string", "minLength": 1 },
    "schemaVersion": {
      "type": "string",
      "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"
    },
    "id": {
      "type": "string",
      "pattern": "^[A-Z0-9][A-Z0-9._-]+$"
    },
    "title": { "type": "string", "minLength": 1 },
    "process": { "type": "string", "minLength": 1 },
    "sourceRefs": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "type": "string", "minLength": 1 }
    },
    "entities": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "scope", "role", "geometry"],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z0-9][a-z0-9._-]+$"
          },
          "scope": {
            "enum": ["individual", "cohort", "template", "unspecified"]
          },
          "role": {
            "enum": [
              "build-artifact",
              "derived-test-specimen",
              "prepared-sample",
              "fracture-artifact",
              "measurement-artifact"
            ]
          },
          "coordinateFrameRef": { "type": "string", "minLength": 1 },
          "geometry": {
            "type": "object",
            "additionalProperties": false,
            "required": ["family", "definitionStatus"],
            "properties": {
              "family": { "type": "string", "minLength": 1 },
              "definitionStatus": {
                "enum": ["complete", "incomplete", "not-applicable"]
              },
              "parameters": { "type": "object" },
              "missingParameters": {
                "type": "array",
                "uniqueItems": true,
                "items": { "type": "string", "minLength": 1 }
              },
              "notes": {
                "type": "array",
                "items": { "type": "string", "minLength": 1 }
              }
            }
          }
        }
      }
    },
    "coordinateFrames": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "frameType", "transformToParent"],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z0-9][a-z0-9._-]+$"
          },
          "frameType": {
            "enum": [
              "machine",
              "build-platform",
              "build",
              "scan",
              "artifact",
              "sample",
              "measurement",
              "fracture-surface",
              "instrument",
              "material-history"
            ]
          },
          "parentFrameRef": { "type": "string", "minLength": 1 },
          "transformToParent": {
            "type": "object",
            "additionalProperties": false,
            "required": ["status"],
            "properties": {
              "model": {
                "enum": ["rigid"]
              },
              "status": {
                "enum": [
                  "exact",
                  "measured",
                  "estimated",
                  "not-reported",
                  "not-applicable"
                ]
              },
              "translationMm": {
                "type": "array",
                "minItems": 3,
                "maxItems": 3,
                "items": { "type": "number" }
              },
              "basis": {
                "type": "object",
                "additionalProperties": false,
                "required": ["x", "y", "z"],
                "properties": {
                  "x": {
                    "type": "array",
                    "minItems": 3,
                    "maxItems": 3,
                    "items": { "type": "number" }
                  },
                  "y": {
                    "type": "array",
                    "minItems": 3,
                    "maxItems": 3,
                    "items": { "type": "number" }
                  },
                  "z": {
                    "type": "array",
                    "minItems": 3,
                    "maxItems": 3,
                    "items": { "type": "number" }
                  }
                }
              },
              "uncertaintyMm": { "type": "number", "minimum": 0 }
            }
          }
        }
      }
    },
    "derivations": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["type", "parentRef", "childRef", "evidence"],
        "properties": {
          "type": {
            "enum": [
              "extracted-from",
              "machined-from",
              "sectioned-from",
              "fractured-from",
              "prepared-from"
            ]
          },
          "parentRef": { "type": "string", "minLength": 1 },
          "childRef": { "type": "string", "minLength": 1 },
          "evidence": {
            "type": "object",
            "additionalProperties": false,
            "required": ["status", "sourceRef", "locator"],
            "properties": {
              "status": {
                "enum": ["reported", "schematic-only", "derived", "not-reported"]
              },
              "sourceRef": { "type": "string", "minLength": 1 },
              "locator": { "type": "string", "minLength": 1 }
            }
          }
        }
      }
    },
    "orientationConstraints": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "subjectRef",
          "relationType",
          "first",
          "second",
          "angleDeg",
          "azimuthStatus",
          "evidence"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z0-9][a-z0-9._-]+$"
          },
          "subjectRef": { "type": "string", "minLength": 1 },
          "relationType": {
            "enum": ["axis-to-axis", "axis-to-plane", "plane-to-plane"]
          },
          "first": {
            "type": "object",
            "additionalProperties": false,
            "required": ["frameRef", "feature"],
            "properties": {
              "frameRef": { "type": "string", "minLength": 1 },
              "feature": { "type": "string", "minLength": 1 }
            }
          },
          "second": {
            "type": "object",
            "additionalProperties": false,
            "required": ["frameRef", "feature"],
            "properties": {
              "frameRef": { "type": "string", "minLength": 1 },
              "feature": { "type": "string", "minLength": 1 }
            }
          },
          "angleDeg": { "type": "number", "minimum": 0, "maximum": 180 },
          "azimuthStatus": {
            "enum": ["reported", "not-reported", "not-applicable"]
          },
          "evidence": {
            "type": "object",
            "additionalProperties": false,
            "required": ["status", "sourceRef", "locator"],
            "properties": {
              "status": {
                "enum": [
                  "reported",
                  "schematic-only",
                  "reported-text-and-schematic",
                  "derived"
                ]
              },
              "sourceRef": { "type": "string", "minLength": 1 },
              "locator": { "type": "string", "minLength": 1 }
            }
          }
        }
      }
    },
    "measurementRegions": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "entityRef",
          "kind",
          "locationStatus",
          "orientationStatus",
          "evidence"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z0-9][a-z0-9._-]+$"
          },
          "entityRef": { "type": "string", "minLength": 1 },
          "kind": {
            "enum": ["surface", "plane", "volume", "point", "grid", "fracture-surface"]
          },
          "locationStatus": {
            "enum": [
              "exact",
              "measured",
              "estimated",
              "feature-relative",
              "derived-from-test",
              "not-reported"
            ]
          },
          "orientationStatus": {
            "enum": [
              "exact",
              "reported-constraint",
              "measured",
              "estimated",
              "not-reported"
            ]
          },
          "size": {
            "type": "object",
            "additionalProperties": false,
            "required": ["values", "unit"],
            "properties": {
              "values": {
                "type": "array",
                "minItems": 1,
                "items": { "type": "number", "exclusiveMinimum": 0 }
              },
              "unit": { "type": "string", "minLength": 1 }
            }
          },
          "samplingGrid": {
            "type": "object",
            "additionalProperties": false,
            "required": ["rows", "columns", "spacing"],
            "properties": {
              "rows": { "type": "integer", "minimum": 1 },
              "columns": { "type": "integer", "minimum": 1 },
              "spacing": {
                "type": "object",
                "additionalProperties": false,
                "required": ["value", "unit"],
                "properties": {
                  "value": { "type": "number", "exclusiveMinimum": 0 },
                  "unit": { "type": "string", "minLength": 1 }
                }
              }
            }
          },
          "anchor": { "type": "string", "minLength": 1 },
          "evidence": {
            "type": "object",
            "additionalProperties": false,
            "required": ["status", "sourceRef", "locator"],
            "properties": {
              "status": { "enum": ["reported", "schematic-only", "derived"] },
              "sourceRef": { "type": "string", "minLength": 1 },
              "locator": { "type": "string", "minLength": 1 }
            }
          }
        }
      }
    },
    "reportedContext": { "type": "object" },
    "evidenceGaps": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "type": "string", "minLength": 1 }
    },
    "notes": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 }
    }
  }
}
