{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/skidzo/AddiSpec/schemas/specimen.schema.json",
  "title": "AddiSpec specimen",
  "type": "object",
  "additionalProperties": true,
  "required": [
    "schemaVersion",
    "id",
    "status",
    "process",
    "purpose",
    "design",
    "artifacts",
    "provenance",
    "qualification"
  ],
  "properties": {
    "schemaVersion": {
      "type": "string",
      "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"
    },
    "id": {
      "type": "string",
      "pattern": "^[A-Z0-9][A-Z0-9._-]+$"
    },
    "status": {
      "enum": [
        "draft",
        "digital-geometry-verified",
        "manufacturing-validated",
        "qualified"
      ]
    },
    "process": {
      "type": "object",
      "required": [
        "category",
        "normativeConformance"
      ]
    },
    "purpose": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string"
      }
    },
    "design": {
      "type": "object",
      "required": [
        "geometryFamily",
        "units",
        "nominalDimensions",
        "buildOrientation"
      ]
    },
    "artifacts": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "role",
          "format",
          "path",
          "sha256",
          "bytes"
        ],
        "properties": {
          "sha256": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          },
          "bytes": {
            "type": "integer",
            "minimum": 1
          }
        }
      }
    },
    "provenance": {
      "type": "object",
      "required": [
        "createdBy",
        "authoringSystem",
        "createdAt"
      ]
    },
    "qualification": {
      "type": "object",
      "required": [
        "manufacturingQualified",
        "missingEvidence"
      ]
    }
  }
}
